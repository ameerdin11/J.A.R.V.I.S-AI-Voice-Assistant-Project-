# OpenAI API Configuration (Required if LLM_MODE is openai)
OPENAI_API_KEY=your_openai_api_key_here

# Brain/LLM Settings (openai | ollama)
LLM_MODE=openai
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Text-to-Speech settings (online | offline)
TTS_MODE=online
# Offline TTS Backend (pyttsx3 | coqui)
OFFLINE_TTS_BACKEND=pyttsx3
COQUI_MODEL_NAME=tts_models/en/ljspeech/vits

# Speech-to-Text (ASR) Settings
# Whisper models: tiny, base, small, medium, large
ASR_MODEL_NAME=tiny

# Microphone & Audio Settings
# If MIC_INDEX is empty, the default microphone will be used
MIC_INDEX=
MIC_ENERGY_THRESHOLD=1500
WAKE_WORD=hey jarvis

# Simulation Mode (True | False)
# Set to True to print GPIO action outputs to terminal without GPIO hardware
SIMULATION_MODE=True
